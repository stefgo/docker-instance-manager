        "build": "tsc && cp -r src/web/public dist/web/ && bash ../scripts/generate-version.sh dist/VERSION"
    },
    "dependencies": {
        "@dim/shared": "*",
        "@fastify/static": "^10.1.3",
        "@fastify/websocket": "^11.3.0",
        "@types/node-forge": "^1.3.14",
        "better-sqlite3": "^13.0.3",
        "dockerode": "^5.0.1",
        "fastify": "^5.12.4",
        "node-cron": "^4.6.0",
        "umzug": "^3.8.3",
        "ws": "^8.19.0",
        "yaml": "^2.9.0"
    },
    "devDependencies": {
        "@types/dockerode": "^3.3.47",
        "@types/node": "^25.9.6",
        "@types/node-cron": "^3.0.11",
        "@types/ws": "^8.18.1",
        "rimraf": "^6.1.3",
        "tsx": "^4.23.13",
        "typescript": "^5.9.3"
    }
