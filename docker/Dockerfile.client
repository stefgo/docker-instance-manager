# Builder Stage
FROM node:22-bookworm AS builder

WORKDIR /app

# Copy manifest files and registry config
COPY package.json package-lock.json .npmrc ./
COPY client/package.json client/
COPY shared/package.json shared/
COPY server/backend/package.json server/backend/
COPY server/frontend/package.json server/frontend/

# Install all dependencies (including dev for building, with GitHub Packages auth)
RUN --mount=type=secret,id=npm_token \
    NPM_TOKEN=$(cat /run/secrets/npm_token) npm ci

# Copy source code
COPY shared ./shared
COPY client ./client
COPY scripts ./scripts

# Build shared and client
RUN npm run build -w shared
RUN npm run build -w client

# Generate Version file for production
ARG APP_VERSION=unknown
RUN APP_VERSION=${APP_VERSION} bash ./scripts/generate-version.sh ./client/dist/VERSION

# Prune dev dependencies.
# `npm prune` works on the node_modules tree that is already there -- no second
# registry round trip and no rebuild of native modules (better-sqlite3), unlike
# `npm ci --omit=dev`.
RUN npm prune --omit=dev

# Runner Stage
FROM debian:bookworm-slim AS runner

ENV DEBIAN_FRONTEND=noninteractive
ENV NODE_ENV=production
# Tells the agent it runs in this image, which is the only place /api/health is served --
# see getWebRoutes() in client/src/web/server.ts.
ENV DIM_CONTAINER=true

# Install dependencies (Node.js + libsqlite3)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    wget \
    ca-certificates \
    gnupg \
    curl \
    lsb-release \
    libsqlite3-0 \
    && \
    # Node.js Setup
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    nodejs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy artifacts from builder
COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/shared/package.json ./shared/
COPY --from=builder /app/shared/dist ./shared/dist
COPY --from=builder /app/client/package.json ./client/
COPY --from=builder /app/client/dist ./client/dist

# Switch to client directory so paths align with dev environment (config.json resolution)
WORKDIR /app/client

# Liveness probe against the agent's web server (DIM_CLIENT_PORT, default 3001). It reports
# on the agent process, not on its connection to the server -- see /api/health in
# src/web/server.ts. The route exists in this image whatever config.yaml disables and answers
# loopback only: with both pages disabled and no outbound mode the web server still starts
# for it, bound to 127.0.0.1.
# Docker does not restart an unhealthy container; restart policies react to exiting.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD node -e 'fetch("http://127.0.0.1:" + (process.env.DIM_CLIENT_PORT || 3001) + "/api/health").then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))'

CMD ["node", "dist/index.js"]
